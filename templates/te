<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sales Invoice Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen p-4 md:p-8">

    <div class="max-w-7xl mx-auto space-y-6">
        
        <div class="flex flex-col md:flex-row md:items-center md:justify-between border-b border-slate-200 pb-4">
            <div>
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">Sales Invoice Ledger</h1>
                <p class="text-sm text-slate-500">Filter transactions, view inventory distributions, and generate printable statements.</p>
            </div>
            <div class="mt-4 md:mt-0">
                <button onclick="generateReport()" class="inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-600 text-white text-sm font-semibold rounded-xl hover:bg-indigo-700 shadow-sm shadow-indigo-100 transition-colors cursor-pointer">
                    <i class="fa-solid fa-file-pdf"></i> Generate Current Report
                </button>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm flex flex-col items-center justify-center">
                <h3 class="text-sm font-bold text-slate-700 mb-4 self-start"><i class="fa-solid fa-chart-pie text-indigo-500 mr-1.5"></i> Sales Type Volume Mix</h3>
                <div class="w-full max-w-[220px]">
                    <canvas id="salesPieChart"></canvas>
                </div>
            </div>

            <div class="lg:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm flex flex-col justify-between">
                    <div>
                        <span class="text-xs font-bold tracking-wider text-slate-400 uppercase">Gross Subtotal Balance</span>
                        <h2 id="summary-subtotal" class="text-3xl font-black text-slate-800 mt-1">0.00 ETB</h2>
                    </div>
                    <div class="text-xs text-indigo-600 font-medium mt-4"><i class="fa-solid fa-arrow-trend-up"></i> Sum of filtered listings</div>
                </div>

                <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm flex flex-col justify-between">
                    <div>
                        <span class="text-xs font-bold tracking-wider text-amber-500 uppercase">Withholding Deductions</span>
                        <h2 id="summary-withholding" class="text-3xl font-black text-amber-600 mt-1">0.00 ETB</h2>
                    </div>
                    <div class="text-xs text-slate-400 mt-4">Calculated at 3% structural rate</div>
                </div>

                <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm flex flex-col justify-between sm:col-span-2 bg-gradient-to-br from-indigo-900 to-slate-900 text-white">
                    <div>
                        <span class="text-xs font-bold tracking-wider text-indigo-200 uppercase">Net Settled Cash Flow</span>
                        <h2 id="summary-net" class="text-4xl font-black text-white mt-1">0.00 ETB</h2>
                    </div>
                    <div class="text-xs text-indigo-200 mt-4 flex justify-between">
                        <span>Active System Context Date: 2026</span>
                        <span id="filtered-count" class="font-bold">Showing: 0 records</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
            <div>
                <label class="block text-xs font-bold text-slate-600 mb-1.5"><i class="fa-solid fa-calendar mr-1"></i> Start Date</label>
                <input type="date" id="filter-start-date" onchange="processDataFilters()" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200 text-slate-800 rounded-lg outline-none focus:border-indigo-500 focus:bg-white">
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 mb-1.5"><i class="fa-solid fa-calendar mr-1"></i> End Date</label>
                <input type="date" id="filter-end-date" onchange="processDataFilters()" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200 text-slate-800 rounded-lg outline-none focus:border-indigo-500 focus:bg-white">
            </div>
            <div class="md:col-span-2">
                <label class="block text-xs font-bold text-slate-600 mb-1.5"><i class="fa-solid fa-magnifying-glass mr-1"></i> Quick Filter (Name, Bank, Phone, Credit Type)</label>
                <div class="relative">
                    <input type="text" id="filter-search" oninput="processDataFilters()" placeholder="Type matching sequence strings..." class="w-full pl-9 pr-4 py-2 text-sm bg-slate-50 border border-slate-200 text-slate-800 rounded-lg outline-none focus:border-indigo-500 focus:bg-white">
                    <i class="fa-solid fa-search absolute left-3 top-3 text-slate-400 text-xs"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse" id="report-target-table">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-100 text-xs font-bold text-slate-500 uppercase tracking-wider">
                            <th class="py-4 px-6">Invoice Ref</th>
                            <th class="py-4 px-6">Date</th>
                            <th class="py-4 px-6">Customer / Client Details</th>
                            <th class="py-4 px-6">Credit Modality</th>
                            <th class="py-4 px-6">Payment Info / Due Date</th>
                            <th class="py-4 px-6 text-right">Net Payable</th>
                        </tr>
                    </thead>
                    <tbody id="ledger-rows-destination" class="divide-y divide-slate-100 text-sm text-slate-700">
                        </tbody>
                </table>
            </div>
            
            <div id="table-empty-state" class="hidden p-12 text-center">
                <i class="fa-solid fa-folder-open text-slate-300 text-4xl mb-3 block"></i>
                <span class="text-sm font-medium text-slate-400">No records found matching current query parameters.</span>
            </div>
        </div>
    </div>

    <script>
        // Server side data injected into JSON structure arrays loop
        console.log("the good",false+6)
        const data = [
            { id: "INV-2026-001", date: "2026-05-10", customerName: "Abebe Bikila", customerPhone: "0911000000", creditType: "cash", bankAccount: "Commercial Bank of Ethiopia (CBE)", returnDate: "", netTotal: 1250.00 },
            { id: "INV-2026-002", date: "2026-05-14", customerName: "Aster Aweke", customerPhone: "0912000000", creditType: "credit", bankAccount: "", returnDate: "2026-06-15", netTotal: 4500.25 },
            { id: "INV-2026-003", date: "2026-05-20", customerName: "Walk-in Cash Client", customerPhone: "N/A", creditType: "cash", bankAccount: "Main Cash Till Desk", returnDate: "", netTotal: 620.00 },
            { id: "INV-2026-004", date: "2026-05-22", customerName: "Dr. Yosef Alula", customerPhone: "0913998877", creditType: "credit", bankAccount: "", returnDate: "2026-07-01", netTotal: 1890.00 },
            { id: "INV-2026-005", date: "2026-05-25", customerName: "Aster Aweke", customerPhone: "0912000000", creditType: "cash", bankAccount: "Awash Bank", netTotal: 340.50 }
        ];

        let salesChartInstance = null;

        // Bootstraps application loops
        document.addEventListener("DOMContentLoaded", () => {
            initializePieChartMetrics();
            processDataFilters();
        });

        // Filters source array data based on criteria
        function processDataFilters() {
            const startDateValue = document.getElementById('filter-start-date').value;
            const endDateValue = document.getElementById('filter-end-date').value;
            const searchKeyword = document.getElementById('filter-search').value.toLowerCase().trim();

            const filteredData = data.filter(item => {
                // 1. Evaluate Date Boundaries
                if (startDateValue && item.date < startDateValue) return false;
                if (endDateValue && item.date > endDateValue) return false;

                // 2. Evaluate Search Keywords Matrix across rows properties
                if (searchKeyword) {
                    const matchesSearch = 
                        item.id.toLowerCase().includes(searchKeyword) ||
                        item.customerName.toLowerCase().includes(searchKeyword) ||
                        item.customerPhone.toLowerCase().includes(searchKeyword) ||
                        item.creditType.toLowerCase().includes(searchKeyword) ||
                        (item.bankAccount && item.bankAccount.toLowerCase().includes(searchKeyword)) ||
                        (item.returnDate && item.returnDate.toLowerCase().includes(searchKeyword));
                    
                    if (!matchesSearch) return false;
                }
                return true;
            });

            renderTableDOMRows(filteredData);
            recalculateFinancialTotalsSummary(filteredData);
            updatePieChartDataMix(filteredData);
        }

        // Renders dynamic components into active DOM layers
        function renderTableDOMRows(recordsList) {
            const tableBody = document.getElementById('ledger-rows-destination');
            const emptyState = document.getElementById('table-empty-state');
            tableBody.innerHTML = '';

            if (recordsList.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            }
            emptyState.classList.add('hidden');

            recordsList.forEach(item => {
                const creditTypeBadge = item.creditType === 'cash' 
                    ? `<span class="px-2 py-0.5 text-xs font-semibold bg-emerald-50 text-emerald-700 rounded-full">Cash Sale</span>`
                    : `<span class="px-2 py-0.5 text-xs font-semibold bg-amber-50 text-amber-700 rounded-full">Credit</span>`;

                const fallbackInfo = item.creditType === 'cash' 
                    ? `<span class="text-xs text-slate-500 flex items-center gap-1"><i class="fa-solid fa-building-columns text-slate-400"></i> ${item.bankAccount || 'N/A'}</span>`
                    : `<span class="text-xs text-rose-600 flex items-center gap-1"><i class="fa-solid fa-clock-rotate-left text-rose-400"></i> Due: ${item.returnDate || 'N/A'}</span>`;

                const rowTemplate = `
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="py-4 px-6 font-mono font-bold text-slate-600">${item.id}</td>
                        <td class="py-4 px-6 text-slate-500 whitespace-nowrap">${item.date}</td>
                        <td class="py-4 px-6">
                            <div class="font-semibold text-slate-800">${item.customerName}</div>
                            <div class="text-xs text-slate-400">${item.customerPhone}</div>
                        </td>
                        <td class="py-4 px-6">${creditTypeBadge}</td>
                        <td class="py-4 px-6">${fallbackInfo}</td>
                        <td class="py-4 px-6 text-right font-bold text-slate-900">${item.netTotal.toFixed(2)} ETB</td>
                    </tr>
                `;
                tableBody.insertAdjacentHTML('beforeend', rowTemplate);
            });
        }

        // Aggregates currency tallies logic dynamically
        function recalculateFinancialTotalsSummary(recordsList) {
            let netTotalSum = 0;
            recordsList.forEach(i => netTotalSum += i.netTotal);
            // Reconstruct backing components formulas context logic backwards
            // Net Total = Subtotal - Withholding(3%) -> Net = Subtotal * 0.97 -> Subtotal = Net / 0.97
            const grossSubtotal = netTotalSum / 0.97;
            const withholdingTax = grossSubtotal * 0.03;

            document.getElementById('summary-subtotal').innerText = grossSubtotal.toFixed(2) + " ETB";
            document.getElementById('summary-withholding').innerText = "-" + withholdingTax.toFixed(2) + " ETB";
            document.getElementById('summary-net').innerText = netTotalSum.toFixed(2) + " ETB";
            document.getElementById('filtered-count').innerText = `Showing: ${recordsList.length} records`;
        }

        // Configures ChartJS metrics context rules
        function initializePieChartMetrics() {
            const ctx = document.getElementById('salesPieChart').getContext('2d');
            salesChartInstance = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: ['Cash Sale', 'Credit'],
                    datasets: [{
                        data: [0, 0],
                        backgroundColor: ['#10b981', '#f59e0b'],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { boxWidth: 12, font: { size: 11, weight: 'bold' } }
                        }
                    }
                }
            });
        }

        // Updates pie chart datasets dynamically
        function updatePieChartDataMix(recordsList) {
            let cashCount = 0;
            let creditCount = 0;

            recordsList.forEach(item => {
                if (item.creditType === 'cash') cashCount++;
                if (item.creditType === 'credit') creditCount++;
            });

            if (salesChartInstance) {
                salesChartIndynamicdynamicstance.data.datasets[0].data = [cashCount, creditCount];
                salesChartInstance.update();
            }
        }

        // Clean Print Output Document Generator Integration Rule
        function generateReport() {
            window.print();
        }
    </script>

    <style>
        @media print {
            body { background: #ffffff !important; color: #000000 !important; p: 0 !important; }
            button, label, #salesPieChart, .select2-container, #filter-start-date, #filter-end-date, #filter-search, .grid-cols-1 {
                display: none !important;
            }
            #report-target-table { width: 100% !important; border: 1px solid #cbd5e1 !important; }
            th { background-color: #f1f5f9 !important; color: #000000 !important; }
        }
    </style>
</body>
</html>